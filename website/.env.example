# kkn-badko-blog — environment template (SRS NFR-018 / §2.1.8)
# Copy to .env.local and fill in real values.
# .env.local is gitignored — real secrets are NEVER committed (BR-006).

# --- Blogger content source (server-side ONLY, never sent to the browser — BR-004) ---
# API key: Google Cloud Console -> APIs & Services -> enable "Blogger API v3"
#          -> Credentials -> Create credentials -> API key
BLOGGER_API_KEY=REPLACE_WITH_GOOGLE_CLOUD_API_KEY
# Blog ID: the number in your Blogger dashboard URL,
#          e.g. https://www.blogger.com/blog/posts/1234567890123456789
BLOG_ID=REPLACE_WITH_BLOGGER_BLOG_ID

# --- Rendering (BR-003 / BR-007; decided value: 600 s) ---
ISR_REVALIDATE=600

# --- Public values (safe in the browser; NEXT_PUBLIC_ prefix required by Next.js) ---
# Canonical site URL, used for sitemap.xml, Open Graph, and JSON-LD (NFR-015).
# Use http://localhost:3000 in development; the *.vercel.app URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Owner email for the Contact page mailto: link (FR-019, BR-009)
NEXT_PUBLIC_CONTACT_EMAIL=owner@example.com
